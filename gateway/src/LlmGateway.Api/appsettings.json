{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=llm_gateway;Username=gateway;Password=gateway",
    "Redis": "localhost:6379"
  },
  "Telemetry": {
    "ServiceName": "llm-gateway",
    "ExportIntervalMs": 5000
  },
  "Gateway": {
    "AdminKey": "",
    "CacheTtlSeconds": 3600,
    "Resilience": {
      "RetryAttempts": 2,
      "RetryDelayMs": 200,
      "MinimumThroughput": 4,
      "FailureRatio": 0.5,
      "SamplingSeconds": 30,
      "BreakSeconds": 15
    },
    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "BaseUrl": "https://api.openai.com/v1",
        "RequireApiKey": true,
        "TimeoutSeconds": 60
      },
      "ollama": {
        "Type": "openai-compatible",
        "BaseUrl": "http://ollama:11434/v1",
        "RequireApiKey": false,
        "TimeoutSeconds": 120
      },
      "mock": {
        "Type": "mock",
        "LatencyMs": 120
      },
      "mock-unstable": {
        "Type": "mock",
        "LatencyMs": 250,
        "FailureRate": 0.35
      }
    },
    "Models": [
      { "Alias": "default", "Targets": [ "openai/gpt-4o-mini", "ollama/qwen2.5:7b", "mock/mock-1" ] },
      { "Alias": "gpt-4o-mini", "Targets": [ "openai/gpt-4o-mini", "ollama/qwen2.5:7b" ] },
      { "Alias": "gpt-4o", "Targets": [ "openai/gpt-4o" ] },
      { "Alias": "qwen2.5:7b", "Targets": [ "ollama/qwen2.5:7b" ] },
      { "Alias": "mock-1", "Targets": [ "mock/mock-1" ] },
      { "Alias": "mock-resilient", "Targets": [ "mock-unstable/mock-2", "mock/mock-1" ] }
    ],
    "Pricing": [
      { "Target": "openai/gpt-4o-mini", "InputPerMillion": 0.15, "OutputPerMillion": 0.60 },
      { "Target": "openai/gpt-4o", "InputPerMillion": 2.50, "OutputPerMillion": 10.00 },
      { "Target": "ollama/qwen2.5:7b", "InputPerMillion": 0, "OutputPerMillion": 0 },
      { "Target": "mock/mock-1", "InputPerMillion": 0.50, "OutputPerMillion": 1.50 },
      { "Target": "mock-unstable/mock-2", "InputPerMillion": 0.30, "OutputPerMillion": 1.20 }
    ],
    "SeedClients": [
      { "Id": "insightql", "Name": "InsightQL", "RequestsPerMinute": 120, "MonthlyTokenQuota": 5000000 },
      { "Id": "docflow", "Name": "DocFlow", "RequestsPerMinute": 120, "MonthlyTokenQuota": 5000000 },
      { "Id": "zapagent", "Name": "ZapAgent", "RequestsPerMinute": 120, "MonthlyTokenQuota": 5000000 },
      { "Id": "farmaradar", "Name": "FarmaRadar", "RequestsPerMinute": 120, "MonthlyTokenQuota": 5000000 },
      { "Id": "playground", "Name": "Playground", "RequestsPerMinute": 30, "MonthlyTokenQuota": 200000 },
      { "Id": "sandbox", "Name": "Sandbox (limite baixo)", "RequestsPerMinute": 5, "MonthlyTokenQuota": 50000 }
    ]
  }
}
